---
// Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950">
  <div class="mx-auto max-w-2xl px-4 py-8">
    <!-- Links principales -->
    <div class="flex flex-wrap justify-center gap-6 text-sm mb-6">
      <a
        href="/"
        class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
      >
        Inicio
      </a>
      <a
        href="/disclaimer"
        class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
      >
        Aviso Legal
      </a>
      <a
        href="https://lamardeparques.es"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
      >
        Sitio Oficial
      </a>
      <a
        href="https://lamardeparques.es/foro"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
      >
        Foro Original
      </a>
      <a
        href="https://lamardeparques.es/foro/app.php/feed"
        target="_blank"
        rel="noopener noreferrer"
        class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors flex items-center gap-1"
      >
        RSS Feed
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
          <path d="M5 3a1 1 0 000 2c5.523 0 10 4.477 10 10a1 1 0 102 0C17 8.373 11.627 3 5 3z"></path>
          <path d="M4 9a1 1 0 011-1 7 7 0 017 7 1 1 0 11-2 0 5 5 0 00-5-5 1 1 0 01-1-1zM3 15a2 2 0 114 0 2 2 0 01-4 0z"></path>
        </svg>
      </a>
    </div>

    <!-- Separador -->
    <div class="border-t border-zinc-200 dark:border-zinc-800 mb-6"></div>

    <!-- Info y copyright -->
    <div class="text-center space-y-2">
      <p class="text-sm text-zinc-600 dark:text-zinc-400">
        Visualización alternativa del feed RSS de <strong class="text-zinc-900 dark:text-zinc-100">La Mar de Parques</strong>
      </p>
      <p class="text-xs text-zinc-500 dark:text-zinc-500">
        © {currentYear} Este sitio no está afiliado con La Mar de Parques.
      </p>
      <p class="text-xs text-zinc-500 dark:text-zinc-500">
        Contenido obtenido del <a href="https://lamardeparques.es/foro/app.php/feed" target="_blank" rel="noopener noreferrer" class="hover:text-zinc-700 dark:hover:text-zinc-300 underline">feed RSS público</a>.
      </p>
    </div>
  </div>
</footer>
